# RENDERLINE — Environment Variables Template
# Copy this file to .env.local and configure your environment-specific credentials

# Mailer & SMTP Service
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vfx@example.com
SMTP_PASS=your-secure-smtp-password
SENDER_NAME="Raja Rathna Reddy | Render Line"
SENDER_EMAIL=vfx@example.com

# Production Site URL (Canonical)
SITE_URL=https://vfx.rajarathnareddy.com

# Editorial & Monetization Flags
SHOW_AI_DISCLOSURE=false
SPONSOR_NVIDIA_URL=/advertise

# API Authentication & Automation Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=generate_a_secure_random_64_char_hex_token
ADMIN_API_KEY=generate_a_secure_random_64_char_hex_token
